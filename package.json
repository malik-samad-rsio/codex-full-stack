{
  "name": "codex-full-stack",
  "version": "1.0.0",
  "description": "Basic full-stack webapp with Express, React SSR, Sequelize, TypeScript",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/client/index.tsx --bundle --outfile=dist/client-bundle/client.js"
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev src/server/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sequelize": "^6.35.1",
    "mysql2": "^3.9.3",
    "swagger-ui-express": "^4.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.7",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
    ,"esbuild": "^0.19.2"
  }
}
